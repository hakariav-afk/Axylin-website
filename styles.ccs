/* =========================================================
   AXILYN WEBSITE
   Main stylesheet
   ========================================================= */

/* ---------- RESET ---------- */

* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: 80px;
}

body {
  font-family: Inter, Arial, Helvetica, sans-serif;
  color: #17211b;
  background: #ffffff;
  line-height: 1.6;
}

img,
svg {
  max-width: 100%;
}

button,
input,
select,
textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

a {
  color: inherit;
}


/* ---------- BRAND VARIABLES ---------- */

:root {
  --brand: #0f6b3a;
  --brand-dark: #084c2a;
  --brand-light: #e6f1ea;

  --background: #ffffff;
  --background-soft: #f7faf8;

  --text: #17211b;
  --text-muted: #5d6b62;

  --border: #dfe9e3;

  --shadow-small: 0 6px 20px rgba(15, 107, 58, 0.06);
  --shadow-medium: 0 12px 35px rgba(15, 107, 58, 0.1);

  --radius: 16px;
  --radius-small: 10px;

  --max-width: 1150px;
}


/* ---------- GLOBAL LAYOUT ---------- */

.container {
  width: min(100% - 40px, var(--max-width));
  margin-inline: auto;
}

.section {
  padding: 90px 0;
  background: var(--background);
}

.section.alt {
  background: var(--background-soft);
}

.section-title {
  color: var(--brand-dark);
  font-size: clamp(2rem, 4vw, 3rem);
  line-height: 1.15;
  margin-bottom: 12px;
  font-weight: 800;
}

.section-sub {
  color: var(--text-muted);
  max-width: 700px;
  font-size: 1.05rem;
  margin-bottom: 45px;
}


/* ---------- HEADER ---------- */

.site-header {
  position: sticky;
  top: 0;
  z-index: 1000;

  background: rgba(255, 255, 255, 0.95);
  backdrop-filter: blur(12px);

  border-bottom: 1px solid var(--border);
}

.site-header .container {
  min-height: 72px;

  display: flex;
  align-items: center;
  justify-content: space-between;
}


/* ---------- LOGO ---------- */

.logo,
.brand {
  color: var(--brand-dark);
  text-decoration: none;
  font-size: 1.55rem;
  font-weight: 800;
  letter-spacing: -0.03em;
}


/* ---------- NAVIGATION ---------- */

.main-nav {
  display: flex;
  align-items: center;
}

.nav-list {
  list-style: none;

  display: flex;
  align-items: center;
  gap: 8px;
}

.nav-link {
  display: block;

  padding: 9px 13px;

  color: var(--text);
  text-decoration: none;
  font-size: 0.95rem;
  font-weight: 600;

  border-radius: 8px;

  transition:
    color 0.2s ease,
    background 0.2s ease;
}

.nav-link:hover {
  color: var(--brand);
  background: var(--brand-light);
}


/* ---------- MOBILE NAV BUTTON ---------- */

.nav-toggle {
  display: none;

  width: 44px;
  height: 44px;

  background: transparent;
  border: 1px solid var(--border);
  border-radius: 10px;
}

.hamburger,
.hamburger::before,
.hamburger::after {
  display: block;

  width: 20px;
  height: 2px;

  background: var(--brand-dark);

  margin: auto;

  transition: transform 0.2s ease;
}

.hamburger {
  position: relative;
}

.hamburger::before,
.hamburger::after {
  content: "";
  position: absolute;
  left: 0;
}

.hamburger::before {
  top: -7px;
}

.hamburger::after {
  top: 7px;
}


/* ---------- HERO ---------- */

.hero {
  position: relative;
  overflow: hidden;

  background:
    radial-gradient(
      circle at 85% 25%,
      var(--brand-light) 0,
      transparent 34%
    ),
    var(--background-soft);

  padding: 105px 0;
}

.hero-inner {
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  align-items: center;
  gap: 70px;
}

.hero h1 {
  color: var(--brand-dark);

  font-size: clamp(2.7rem, 6vw, 4.8rem);
  line-height: 1.03;

  letter-spacing: -0.05em;

  max-width: 760px;

  margin-bottom: 25px;
}

.hero p {
  color: var(--text-muted);

  max-width: 650px;

  font-size: 1.15rem;
  line-height: 1.75;

  margin-bottom: 30px;
}


/* ---------- HERO BUTTONS ---------- */

.hero-actions {
  display: flex;
  align-items: center;
  gap: 12px;
  flex-wrap: wrap;
}


/* ---------- HERO PILLS ---------- */

.home-features {
  list-style: none;

  display: flex;
  flex-wrap: wrap;
  gap: 10px;

  margin-top: 25px;
}

.pill {
  display: inline-flex;
  align-items: center;

  padding: 7px 12px;

  background: var(--brand-light);
  color: var(--brand-dark);

  border: 1px solid #cfe2d6;
  border-radius: 999px;

  font-size: 0.85rem;
  font-weight: 700;
}


/* ---------- HERO VISUAL ---------- */

.hero-visual {
  display: flex;
  align-items: center;
  justify-content: center;

  background: #ffffff;

  border: 1px solid var(--border);
  border-radius: 24px;

  padding: 25px;

  box-shadow: var(--shadow-medium);
}

.math-visual {
  width: 100%;
  height: auto;
}


/* ---------- BUTTONS ---------- */

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;

  min-height: 46px;

  padding: 11px 20px;

  border-radius: 10px;

  font-weight: 700;
  text-decoration: none;

  border: 1px solid transparent;

  transition:
    transform 0.2s ease,
    background 0.2s ease,
    box-shadow 0.2s ease;
}

.btn:hover {
  transform: translateY(-2px);
}

.btn.primary {
  background: var(--brand);
  color: #ffffff;

  box-shadow: 0 7px 18px rgba(15, 107, 58, 0.18);
}

.btn.primary:hover {
  background: var(--brand-dark);
  box-shadow: 0 10px 25px rgba(15, 107, 58, 0.22);
}

.btn.large {
  padding: 14px 25px;
  font-size: 1rem;
}


/* ---------- CARDS ---------- */

.cards {
  display: grid;

  grid-template-columns: repeat(4, 1fr);

  gap: 20px;
}

.card {
  background: #ffffff;

  border: 1px solid var(--border);
  border-radius: var(--radius);

  padding: 28px;

  box-shadow: var(--shadow-small);

  transition:
    transform 0.25s ease,
    box-shadow 0.25s ease,
    border-color 0.25s ease;
}

.card:hover {
  transform: translateY(-6px);

  border-color: #c8ddd0;

  box-shadow: var(--shadow-medium);
}

.card h3 {
  color: var(--brand-dark);

  font-size: 1.2rem;

  margin-bottom: 12px;
}

.card p {
  color: var(--text-muted);
}


/* ---------- THREE POINTS ---------- */

.three-points {
  display: grid;

  grid-template-columns: repeat(3, 1fr);

  gap: 25px;

  margin-bottom: 35px;
}

.point {
  background: #ffffff;

  border: 1px solid var(--border);
  border-radius: var(--radius);

  padding: 30px;

  box-shadow: var(--shadow-small);
}

.point h3 {
  color: var(--brand);

  font-size: 1.4rem;

  margin-bottom: 10px;
}

.point p {
  color: var(--text-muted);
}


/* ---------- GOAL ---------- */

.goal {
  background: var(--brand);

  color: #ffffff;

  border-radius: var(--radius);

  padding: 30px;

  box-shadow: var(--shadow-medium);
}

.goal h4 {
  font-size: 1.2rem;
  margin-bottom: 8px;
}

.goal p {
  color: rgba(255, 255, 255, 0.88);
}


/* ---------- TWO COLUMN SECTIONS ---------- */

.two-col {
  display: grid;

  grid-template-columns: 1fr 1fr;

  gap: 50px;

  align-items: start;
}

.content h3 {
  color: var(--brand-dark);

  font-size: 1.5rem;

  margin-bottom: 20px;
}


/* ---------- CHECKLIST ---------- */

.checklist {
  list-style: none;

  display: grid;

  gap: 14px;

  margin-bottom: 25px;
}

.checklist li {
  position: relative;

  padding-left: 30px;

  color: var(--text-muted);
}

.checklist li::before {
  content: "✓";

  position: absolute;

  left: 0;
  top: 0;

  width: 21px;
  height: 21px;

  display: flex;
  align-items: center;
  justify-content: center;

  background: var(--brand-light);

  color: var(--brand);

  border-radius: 50%;

  font-size: 0.75rem;
  font-weight: 800;
}


/* ---------- PRICING ---------- */

.pricing {
  margin-top: 35px;

  padding: 25px;

  background: var(--background-soft);

  border: 1px solid var(--border);

  border-radius: var(--radius);
}

.pricing h4 {
  color: var(--brand-dark);

  margin-bottom: 5px;
}

.price-note,
.muted {
  color: var(--text-muted);
}

.price {
  margin: 12px 0 18px;
}

.price.large {
  display: flex;
  align-items: baseline;
  gap: 6px;

  flex-wrap: wrap;
}

.price-amount {
  color: var(--brand-dark);

  font-size: 2.4rem;

  font-weight: 800;
}

.price-unit {
  color: var(--text-muted);
  font-size: 0.9rem;
}


/* ---------- BOOKING / APPLICATION CARDS ---------- */

.booking-card,
.application-card {
  background: #ffffff;

  border: 1px solid var(--border);

  border-radius: var(--radius);

  padding: 30px;

  box-shadow: var(--shadow-medium);
}

.booking-card h3,
.application-card h3 {
  color: var(--brand-dark);

  font-size: 1.5rem;

  margin-bottom: 25px;
}


/* ---------- FORMS ---------- */

.form {
  display: grid;
  gap: 9px;
}

.form label {
  color: var(--text);

  font-size: 0.9rem;
  font-weight: 700;

  margin-top: 8px;
}

.form input,
.form select,
.form textarea {
  width: 100%;

  padding: 12px 13px;

  color: var(--text);

  background: #ffffff;

  border: 1px solid #cfdcd4;

  border-radius: 9px;

  outline: none;

  transition:
    border-color 0.2s ease,
    box-shadow 0.2s ease;
}

.form textarea {
  resize: vertical;
}

.form input:focus,
.form select:focus,
.form textarea:focus {
  border-color: var(--brand);

  box-shadow: 0 0 0 3px rgba(15, 107, 58, 0.1);
}

.form .btn {
  margin-top: 12px;
}

.form-feedback {
  min-height: 24px;

  color: var(--brand-dark);

  font-size: 0.9rem;
}

.small {
  font-size: 0.82rem;
}


/* ---------- FAQ ---------- */

.faq-list {
  max-width: 850px;
}

.faq-item {
  background: #ffffff;

  border: 1px solid var(--border);

  border-radius: 12px;

  margin-bottom: 12px;

  overflow: hidden;
}

.faq-question {
  width: 100%;

  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 18px 20px;

  background: #ffffff;

  color: var(--text);

  border: none;

  text-align: left;

  font-weight: 700;
}

.faq-question::after {
  content: "+";

  color: var(--brand);

  font-size: 1.3rem;

  transition: transform 0.2s ease;
}

.faq-question[aria-expanded="true"]::after {
  content: "−";
}

.faq-answer {
  padding: 0 20px 20px;

  color: var(--text-muted);
}


/* ---------- CONTACT ---------- */

.contact-grid {
  display: grid;

  grid-template-columns: 1.1fr 0.9fr;

  gap: 45px;

  align-items: start;
}

.contact-info {
  padding: 30px;

  background: #ffffff;

  border: 1px solid var(--border);

  border-radius: var(--radius);

  box-shadow: var(--shadow-small);
}

.contact-info h3,
.contact-info h4 {
  color: var(--brand-dark);

  margin-bottom: 10px;
}

.contact-info h4 {
  margin-top: 30px;
}


/* ---------- FINAL CTA ---------- */

.final-cta {
  background: var(--brand-dark);

  padding: 80px 0;
}

.final-cta-inner {
  text-align: center;

  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 25px;
}

.final-cta h2 {
  color: #ffffff;

  font-size: clamp(2rem, 4vw, 3.2rem);

  line-height: 1.15;

  max-width: 750px;
}


/* ---------- REVEAL ANIMATION ---------- */

.reveal {
  opacity: 1;
  transform: translateY(0);
}

/*
   If your JavaScript adds the "visible" class,
   these rules create the reveal animation.
*/

.js .reveal {
  opacity: 0;
  transform: translateY(20px);

  transition:
    opacity 0.6s ease,
    transform 0.6s ease;
}

.js .reveal.visible {
  opacity: 1;
  transform: translateY(0);
}


/* ---------- FOOTER ---------- */

.site-footer {
  background: #06351e;

  color: #dce9e1;

  padding: 45px 0;
}

.site-footer a {
  color: #ffffff;
  text-decoration: none;
}

.site-footer a:hover {
  color: var(--brand-light);
}


/* ---------- RESPONSIVE TABLET ---------- */

@media (max-width: 950px) {

  .hero-inner {
    grid-template-columns: 1fr;

    gap: 45px;
  }

  .hero-visual {
    max-width: 650px;
  }

  .cards {
    grid-template-columns: repeat(2, 1fr);
  }

  .three-points {
    grid-template-columns: 1fr;
  }

  .two-col {
    grid-template-columns: 1fr;
  }

  .contact-grid {
    grid-template-columns: 1fr;
  }
}


/* ---------- RESPONSIVE MOBILE ---------- */

@media (max-width: 700px) {

  .container {
    width: min(100% - 28px, var(--max-width));
  }

  .section {
    padding: 65px 0;
  }

  .hero {
    padding: 70px 0;
  }

  .hero h1 {
    font-size: clamp(2.4rem, 12vw, 3.5rem);
  }

  .hero p {
    font-size: 1rem;
  }

  .nav-toggle {
    display: block;
  }

  .nav-list {
    position: absolute;

    top: 72px;
    left: 14px;
    right: 14px;

    display: none;
    flex-direction: column;

    align-items: stretch;

    gap: 4px;

    padding: 12px;

    background: #ffffff;

    border: 1px solid var(--border);

    border-radius: 14px;

    box-shadow: var(--shadow-medium);
  }

  .nav-list.open {
    display: flex;
  }

  .nav-link {
    padding: 12px;
  }

  .cards {
    grid-template-columns: 1fr;
  }

  .three-points {
    grid-template-columns: 1fr;
  }

  .two-col,
  .contact-grid {
    grid-template-columns: 1fr;
  }

  .hero-actions {
    flex-direction: column;
    align-items: stretch;
  }

  .hero-actions .btn {
    width: 100%;
  }

  .home-features {
    gap: 7px;
  }

  .pill {
    font-size: 0.78rem;
  }

  .booking-card,
  .application-card {
    padding: 22px;
  }

  .final-cta {
    padding: 65px 0;
  }
}


/* ---------- REDUCED MOTION ---------- */

@media (prefers-reduced-motion: reduce) {

  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
  }
}
